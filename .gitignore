# Dependencies and build output
node_modules/
out/
dist/
release/
# Editor extension: integration-suite bundle, packaged VSIX, downloaded VS Code test builds
extensions/vscode/dist-test/
*.vsix
.vscode-test/
.vite/
coverage/
*.tsbuildinfo

# Local tooling, editors and OS files
.claude/
CLAUDE.local.md
.idea/
.vscode/
.DS_Store
.env
.env.*

# Logs, scratch output, screenshots and test profiles
*.log
logs/
tests/tmp/
screenshots/
shots/
electrondb-shots/
*.png
*.jpg
# App icons live in build/ (and a copy in the renderer assets) and are meant to be committed
!build/**
!src/renderer/src/assets/**
# README images (synthetic demo data only)
!docs/images/
!docs/images/*.png

# Real data that must never be committed: backups, keychains, keys, profile secrets
*.nb3
!tests/fixtures/navicat/**/*.nb3
*.keychain
*.keychain-db
*.pem
*.key
*.p12
credentials.json

# Research notes based on third-party binaries: never commit
docs/research/
