{
  "name": "vortaq",
  "displayName": "Vortaq",
  "description": "Cliente de bases de datos para VS Code: MySQL, MariaDB, PostgreSQL, SQLite, MongoDB y SQL Server",
  "version": "0.8.2",
  "publisher": "y0rshb3",
  "license": "MIT",
  "author": "Y0rshB3",
  "private": true,
  "homepage": "https://github.com/Y0rshB3/Vortaq/tree/main/extensions/vscode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Y0rshB3/Vortaq.git",
    "directory": "extensions/vscode"
  },
  "bugs": {
    "url": "https://github.com/Y0rshB3/Vortaq/issues"
  },
  "icon": "dist/icon.png",
  "galleryBanner": {
    "color": "#0e131c",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.123.0"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "keywords": [
    "mysql",
    "mariadb",
    "postgresql",
    "sqlite",
    "mongodb",
    "sql server",
    "mssql",
    "azure sql",
    "sql",
    "database",
    "base de datos"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onLanguage:sql",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vortaq",
          "title": "Vortaq",
          "icon": "media/vortaq.svg"
        }
      ]
    },
    "views": {
      "vortaq": [
        {
          "id": "vortaq.connections",
          "name": "Conexiones",
          "icon": "media/vortaq.svg",
          "contextualTitle": "Vortaq"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vortaq.connections",
        "contents": "Todavía no hay conexiones.\n[Añadir conexión](command:vortaq.addConnection)\n[Importar de Vortaq](command:vortaq.importDesktop)\nLas contraseñas se guardan cifradas en el almacén seguro del editor. Al importar desde la aplicación de escritorio no se copian: se escriben una vez al conectar."
      }
    ],
    "commands": [
      {
        "command": "vortaq.addConnection",
        "title": "Añadir conexión",
        "category": "Vortaq",
        "icon": "$(add)"
      },
      {
        "command": "vortaq.importDesktop",
        "title": "Importar conexiones de Vortaq (escritorio)",
        "shortTitle": "Importar de Vortaq",
        "category": "Vortaq",
        "icon": "$(desktop-download)"
      },
      {
        "command": "vortaq.refresh",
        "title": "Refrescar",
        "category": "Vortaq",
        "icon": "$(refresh)"
      },
      {
        "command": "vortaq.plan",
        "title": "Plan de ejecución estimado",
        "shortTitle": "Plan estimado",
        "category": "Vortaq",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "vortaq.planActual",
        "title": "Plan de ejecución real (ejecuta la consulta)",
        "shortTitle": "Plan real",
        "category": "Vortaq",
        "icon": "$(pulse)"
      },
      {
        "command": "vortaq.selectTop",
        "title": "Seleccionar las primeras 1000 filas",
        "category": "Vortaq",
        "icon": "$(play)"
      },
      {
        "command": "vortaq.scriptCreate",
        "title": "Script como CREATE",
        "category": "Vortaq",
        "icon": "$(code)"
      },
      {
        "command": "vortaq.findObject",
        "title": "Buscar tabla o vista…",
        "category": "Vortaq",
        "icon": "$(search)"
      },
      {
        "command": "vortaq.queryHistory",
        "title": "Historial de consultas",
        "category": "Vortaq",
        "icon": "$(history)"
      },
      {
        "command": "vortaq.checkUpdates",
        "title": "Buscar actualizaciones",
        "category": "Vortaq",
        "icon": "$(cloud-download)"
      },
      {
        "command": "vortaq.mcp",
        "title": "Agentes (MCP)…",
        "category": "Vortaq",
        "icon": "$(hubot)"
      },
      {
        "command": "vortaq.mcpConnection",
        "title": "Agentes (MCP)…",
        "category": "Vortaq",
        "icon": "$(hubot)"
      },
      {
        "command": "vortaq.connect",
        "title": "Conectar",
        "category": "Vortaq",
        "icon": "$(plug)"
      },
      {
        "command": "vortaq.disconnect",
        "title": "Desconectar",
        "category": "Vortaq",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "vortaq.newQuery",
        "title": "Nueva consulta",
        "category": "Vortaq",
        "icon": "$(new-file)"
      },
      {
        "command": "vortaq.viewData",
        "title": "Ver datos",
        "category": "Vortaq",
        "icon": "$(table)"
      },
      {
        "command": "vortaq.viewDocuments",
        "title": "Ver documentos",
        "category": "Vortaq",
        "icon": "$(json)"
      },
      {
        "command": "vortaq.diagram",
        "title": "Diagrama de relaciones",
        "category": "Vortaq",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "vortaq.queryBuilder",
        "title": "Consulta gráfica",
        "category": "Vortaq",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "vortaq.copyName",
        "title": "Copiar nombre",
        "category": "Vortaq"
      },
      {
        "command": "vortaq.editConnection",
        "title": "Editar conexión",
        "category": "Vortaq",
        "icon": "$(edit)"
      },
      {
        "command": "vortaq.deleteConnection",
        "title": "Eliminar conexión",
        "category": "Vortaq",
        "icon": "$(trash)"
      },
      {
        "command": "vortaq.run",
        "title": "Ejecutar",
        "category": "Vortaq",
        "icon": "$(play)"
      },
      {
        "command": "vortaq.runAll",
        "title": "Ejecutar todo",
        "category": "Vortaq",
        "icon": "$(run-all)"
      },
      {
        "command": "vortaq.stop",
        "title": "Detener",
        "category": "Vortaq",
        "icon": "$(debug-stop)"
      },
      {
        "command": "vortaq.pickConnection",
        "title": "Elegir conexión y base de datos",
        "category": "Vortaq",
        "icon": "$(database)"
      },
      {
        "command": "vortaq.showLog",
        "title": "Mostrar registro",
        "category": "Vortaq"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vortaq.addConnection",
          "when": "view == vortaq.connections",
          "group": "navigation@1"
        },
        {
          "command": "vortaq.importDesktop",
          "when": "view == vortaq.connections",
          "group": "navigation@2"
        },
        {
          "command": "vortaq.refresh",
          "when": "view == vortaq.connections",
          "group": "navigation@3"
        },
        {
          "command": "vortaq.mcp",
          "when": "view == vortaq.connections",
          "group": "2_agents@1"
        },
        {
          "command": "vortaq.queryHistory",
          "when": "view == vortaq.connections",
          "group": "navigation@4"
        },
        {
          "command": "vortaq.findObject",
          "when": "view == vortaq.connections",
          "group": "navigation@0"
        },
        {
          "command": "vortaq.checkUpdates",
          "when": "view == vortaq.connections",
          "group": "3_updates@1"
        }
      ],
      "view/item/context": [
        {
          "command": "vortaq.newQuery",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.(connection|database|schema)\\.sql/",
          "group": "inline@1"
        },
        {
          "command": "vortaq.viewData",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.(table|view)$/",
          "group": "inline@1"
        },
        {
          "command": "vortaq.viewDocuments",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.collection/",
          "group": "inline@1"
        },
        {
          "command": "vortaq.connect",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.connection\\.\\w+\\.closed$/",
          "group": "1_connection@1"
        },
        {
          "command": "vortaq.disconnect",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.connection\\.\\w+\\.open$/",
          "group": "1_connection@1"
        },
        {
          "command": "vortaq.newQuery",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.(connection|database|schema)\\.sql/",
          "group": "2_query@1"
        },
        {
          "command": "vortaq.viewData",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.(table|view)$/",
          "group": "2_query@1"
        },
        {
          "command": "vortaq.viewDocuments",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.collection/",
          "group": "2_query@1"
        },
        {
          "command": "vortaq.newQuery",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.(table|view)$/",
          "group": "2_query@2"
        },
        {
          "command": "vortaq.selectTop",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.(table|view)$/",
          "group": "2_query@3"
        },
        {
          "command": "vortaq.scriptCreate",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.(table|view)$/",
          "group": "2_query@4"
        },
        {
          "command": "vortaq.findObject",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.(connection\\.sql|database\\.sql|schema\\.sql)/",
          "group": "2_query@5"
        },
        {
          "command": "vortaq.diagram",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.(database|schema)\\.sql$/",
          "group": "2_query@3"
        },
        {
          "command": "vortaq.queryBuilder",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.(database|schema)\\.sql$/",
          "group": "2_query@4"
        },
        {
          "command": "vortaq.copyName",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.(connection|database|schema|table|view|collection)/",
          "group": "3_copy@1"
        },
        {
          "command": "vortaq.refresh",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.(connection\\.\\w+\\.open|database|schema|group)/",
          "group": "4_refresh@1"
        },
        {
          "command": "vortaq.editConnection",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.connection/",
          "group": "5_edit@1"
        },
        {
          "command": "vortaq.deleteConnection",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.connection/",
          "group": "5_edit@2"
        },
        {
          "command": "vortaq.mcpConnection",
          "when": "view == vortaq.connections && viewItem =~ /^vortaq\\.connection/",
          "group": "6_agents@1"
        }
      ],
      "editor/title": [
        {
          "command": "vortaq.run",
          "when": "editorLangId == sql && !vortaq.running",
          "group": "navigation@1"
        },
        {
          "command": "vortaq.stop",
          "when": "editorLangId == sql && vortaq.running",
          "group": "navigation@1"
        },
        {
          "command": "vortaq.pickConnection",
          "when": "editorLangId == sql",
          "group": "navigation@2"
        },
        {
          "command": "vortaq.plan",
          "when": "editorLangId == sql",
          "group": "1_plan@1"
        },
        {
          "command": "vortaq.planActual",
          "when": "editorLangId == sql",
          "group": "1_plan@2"
        }
      ],
      "commandPalette": [
        {
          "command": "vortaq.connect",
          "when": "false"
        },
        {
          "command": "vortaq.mcpConnection",
          "when": "false"
        },
        {
          "command": "vortaq.selectTop",
          "when": "false"
        },
        {
          "command": "vortaq.scriptCreate",
          "when": "false"
        },
        {
          "command": "vortaq.disconnect",
          "when": "false"
        },
        {
          "command": "vortaq.viewData",
          "when": "false"
        },
        {
          "command": "vortaq.viewDocuments",
          "when": "false"
        },
        {
          "command": "vortaq.diagram",
          "when": "false"
        },
        {
          "command": "vortaq.queryBuilder",
          "when": "false"
        },
        {
          "command": "vortaq.copyName",
          "when": "false"
        },
        {
          "command": "vortaq.editConnection",
          "when": "false"
        },
        {
          "command": "vortaq.deleteConnection",
          "when": "false"
        },
        {
          "command": "vortaq.run",
          "when": "editorLangId == sql"
        },
        {
          "command": "vortaq.runAll",
          "when": "editorLangId == sql"
        },
        {
          "command": "vortaq.stop",
          "when": "vortaq.running"
        },
        {
          "command": "vortaq.pickConnection",
          "when": "editorLangId == sql"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vortaq.run",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "vortaq.runAll",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ],
    "colors": [
      {
        "id": "vortaq.environment.production",
        "description": "Color de las conexiones de producción en el árbol de Vortaq.",
        "defaults": {
          "dark": "#f87171",
          "light": "#dc2626",
          "highContrast": "#ff6b6b",
          "highContrastLight": "#b91c1c"
        }
      },
      {
        "id": "vortaq.environment.staging",
        "description": "Color de las conexiones de staging en el árbol de Vortaq.",
        "defaults": {
          "dark": "#fbbf24",
          "light": "#b45309",
          "highContrast": "#ffd34d",
          "highContrastLight": "#92400e"
        }
      },
      {
        "id": "vortaq.environment.local",
        "description": "Color de las conexiones locales en el árbol de Vortaq.",
        "defaults": {
          "dark": "#34d399",
          "light": "#047857",
          "highContrast": "#5eead4",
          "highContrastLight": "#065f46"
        }
      }
    ],
    "configuration": {
      "title": "Vortaq",
      "properties": {
        "vortaq.maxRows": {
          "type": "integer",
          "default": 1000,
          "minimum": 1,
          "maximum": 100000,
          "markdownDescription": "Filas que se muestran como máximo en cada resultado y en «Ver datos»."
        },
        "vortaq.typedConfirmEnvironments": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "production",
              "staging",
              "local",
              "other"
            ],
            "enumDescriptions": [
              "Producción (siempre incluida)",
              "Staging",
              "Local",
              "Otro"
            ]
          },
          "uniqueItems": true,
          "default": [
            "production"
          ],
          "markdownDescription": "Entornos en los que cualquier escritura pide escribir el nombre de la conexión. Producción siempre la pide, aunque no esté en la lista. Solo se puede cambiar en los ajustes de usuario (no en los de un espacio de trabajo).",
          "scope": "application"
        },
        "vortaq.confirmDestructive": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Pedir confirmación antes de borrar o eliminar (DROP, TRUNCATE, DELETE, borrar filas) en cualquier conexión. Solo se puede cambiar en los ajustes de usuario.",
          "scope": "application"
        },
        "vortaq.codeLens": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Mostrar la conexión y «Ejecutar» encima de los documentos SQL."
        },
        "vortaq.queryHistory.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Guardar en este equipo las consultas que ejecutas (con su conexión, base de datos, duración y filas; nunca resultados ni errores) para **Vortaq: Historial de consultas**. Al desactivarlo no se guarda nada nuevo; lo guardado se borra desde el historial.",
          "scope": "application"
        },
        "vortaq.updates.check": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Si instalaste la extensión desde un `.vsix`: buscar una vez al día si hay una versión nueva (en las versiones publicadas en GitHub) y ofrecer instalarla. Instalada desde el Marketplace, la actualiza el editor y este ajuste no se usa. **Vortaq: Buscar actualizaciones** funciona siempre. Solo se puede cambiar en los ajustes de usuario.",
          "scope": "application"
        },
        "vortaq.mcp.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Permitir que agentes de IA (MCP) usen Vortaq mientras el editor está abierto: solo las conexiones que actives una a una con **Vortaq: Agentes (MCP)…**, con su nivel (estructura, lectura o lectura y escritura; nunca escritura en Producción). Solo se puede cambiar en los ajustes de usuario.",
          "scope": "application"
        },
        "vortaq.mcp.port": {
          "type": "integer",
          "default": 39291,
          "minimum": 1024,
          "maximum": 65535,
          "markdownDescription": "Puerto local (127.0.0.1) del servidor MCP de Vortaq. Si otro programa lo usa, el servidor no arranca hasta que elijas otro (Vortaq nunca cambia de puerto por su cuenta: los clientes configurados enviarían la clave a ese programa). Solo se puede cambiar en los ajustes de usuario.",
          "scope": "application"
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "vortaq",
        "label": "Vortaq"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12"
  }
}
